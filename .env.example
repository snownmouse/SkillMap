# 服务配置
PORT=3000
NODE_ENV=development
# 逗号分隔白名单。production/staging 必须显式配置；development 可留空表示不限制
CORS_ORIGIN=http://localhost:3000

# ========================================
# LLM 模型分层配置（Agent 架构）
# ========================================
# 每个 Agent 角色可独立配置 provider / model / temperature / max_tokens
# 不配置某角色时，自动回退到 AGENT_DEFAULT_PROVIDER → LLM_PROVIDER → dummy
#
# Agent 角色说明：
#   orchestrator = 编排者：生成中国特色设计指令、选择古语、理解用户全貌
#   skeleton     = 骨架：生成技能树节点结构（30-50节点），需要强推理
#   detail       = 详情：为每个节点填充学习内容（填空型任务，可用便宜模型）
#   coach        = 教练：苏格拉底式对话追问，评估Bloom层级

# 默认 Provider（所有角色不单独配置时的兜底）
# 可选值: dummy | gemini | deepseek | siliconflow | qwen | ark | custom
LLM_PROVIDER=dummy
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# --- 编排者 Agent ---
AGENT_ORCHESTRATOR_PROVIDER=
AGENT_ORCHESTRATOR_MODEL=
AGENT_ORCHESTRATOR_TEMPERATURE=
AGENT_ORCHESTRATOR_MAX_TOKENS=
AGENT_ORCHESTRATOR_TIMEOUT_MS=

# --- 骨架生成 Agent（大模型推荐）---
AGENT_SKELETON_PROVIDER=
AGENT_SKELETON_MODEL=
AGENT_SKELETON_TEMPERATURE=
AGENT_SKELETON_MAX_TOKENS=
AGENT_SKELETON_TIMEOUT_MS=

# --- 节点详情 Agent（小模型推荐，省钱）---
AGENT_DETAIL_PROVIDER=
AGENT_DETAIL_MODEL=
AGENT_DETAIL_TEMPERATURE=
AGENT_DETAIL_MAX_TOKENS=
AGENT_DETAIL_TIMEOUT_MS=

# --- 对话教练 Agent（中模型推荐）---
AGENT_COACH_PROVIDER=
AGENT_COACH_MODEL=
AGENT_COACH_TEMPERATURE=
AGENT_COACH_MAX_TOKENS=
AGENT_COACH_TIMEOUT_MS=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_MODEL=qwen-plus

# 火山引擎 Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k

# 自定义 OpenAI 兼容接口
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# 鉴权与安全
PASSWORD_MIN_LENGTH=6
PASSWORD_COMPLEXITY=false
BCRYPT_COST=12
GUEST_SESSION_TTL_DAYS=30

# 安全开关
ENABLE_DEBUG_ROUTES=false
PUBLIC_METRICS=false
ALLOW_LEGACY_DEFAULT_USER=false

# SQLite 模式
# 不设置 DB_HOST 时默认使用 SQLite
DB_PATH=./data/skillmap.db

# PostgreSQL 模式
# 只有当 DB_HOST 被设置为非 localhost 时才会切换到 PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=skillmap
DB_USER=postgres
DB_PASSWORD=
DB_MAX_CONNECTIONS=20

# Redis（推荐：内网多用户/公网多用户）
REDIS_URL=

# 任务系统（多实例/公网建议启用 Redis）
TASK_QUEUE_MODE=redis
DISABLE_TASK_WORKER=false
DISABLE_TASK_SCHEDULER=false
TASK_SCHEDULER_INTERVAL_MS=5000
TASK_MAX_ATTEMPTS=3
TASK_LEASE_MS=600000
TASK_STALE_MINUTES=30

# WebSocket 限流
WS_RATE_WINDOW_MS=10000
WS_MAX_MESSAGES_PER_WINDOW=50
WS_MAX_CONNECTIONS_PER_IP=20
