# =============================================================================
# SkillMap 环境变量示例
# 复制本文件为 .env 并按需填写。前端也可在「设置 → AI 模型配置」中填写，
# 浏览器端配置会以请求级覆盖方式优先于这里的默认值。
# =============================================================================

# ----- 服务 -----
PORT=3000
NODE_ENV=development
# 生产/预发环境必须显式配置允许的前端来源（逗号分隔），例如：
# CORS_ORIGIN=https://skillmap.example.com,https://www.skillmap.example.com
CORS_ORIGIN=*

# ----- 数据库 -----
# SQLite（开发默认）：只需 DB_PATH
DB_PATH=./data/skillmap.db

# PostgreSQL：当 NODE_ENV=staging|production 时强制启用；
# 其他环境设置 DB_HOST 为非空且非 localhost 时启用。
# DB_HOST=
# DB_PORT=5432
# DB_NAME=skillmap
# DB_USER=postgres
# DB_PASSWORD=
# DB_MAX_CONNECTIONS=20

# ----- Redis（可选，未配置时降级为内存缓存） -----
# REDIS_URL=redis://localhost:6379

# ----- 安全 -----
PASSWORD_MIN_LENGTH=6
# 生产环境建议设为 true 并提高 PASSWORD_MIN_LENGTH
PASSWORD_COMPLEXITY=false
# BCRYPT_COST 范围 10-14，默认 12
# BCRYPT_COST=12
# 访客 Cookie 有效期（天）
# GUEST_SESSION_TTL_DAYS=30

# ----- LLM 通用 -----
# 供应商：gemini | deepseek | siliconflow | qwen | ark | custom | dummy
LLM_PROVIDER=dummy
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=65536
LLM_REQUEST_TIMEOUT_MS=600000

# ----- Ark（火山引擎） -----
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-pro-32k

# ----- SiliconFlow（硅基流动） -----
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ----- DeepSeek -----
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ----- Qwen（通义千问） -----
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# QWEN_MODEL=qwen-plus

# ----- Gemini -----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview

# ----- Custom（任意 OpenAI 兼容接口） -----
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=

# ----- 任务队列 -----
# TASK_QUEUE_MODE=memory | redis
# TREE_GENERATION_MODE=skeleton | full
# TREE_GENERATION_TIMEOUT_MS=1200000
# DISABLE_TASK_WORKER=false

# ----- 调试路由（仅非 production 生效） -----
# ENABLE_DEBUG_ROUTES=false

# ----- 指标 / 监控 -----
# PUBLIC_METRICS=false
# SSR=false

# ----- 旧默认用户兼容（生产环境强制关闭） -----
# ALLOW_LEGACY_DEFAULT_USER=false
